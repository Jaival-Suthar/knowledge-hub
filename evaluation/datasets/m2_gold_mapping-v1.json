      "m1_chunk_id": "b2a438cf47e578ce11794131ada1ce4cdbff9263893bbcc1cccf69412006a197",
      "m1_text_span": "Fear is actually a sign that you are doing what's needed to move in the right direction.",
      "m2_chunk_ids": [
        "756fcb9b3040715bbb1ec76e79f1436b53793ce13aef58610d908722f183c3e9"

      "m1_chunk_id": "a67b37baecbdb7b03f0776b3c4fec21b2e001c0774699c1bf24ba5db5b146dcf",
      "m1_text_span": "Average never yields anything more than average and usually much less.",
      "m2_chunk_ids": [
        "cbe378bd68d385933d3138ad904766db535b93775e7008ab55bf79046419d343"
      ],
      "status": "exact"
    },

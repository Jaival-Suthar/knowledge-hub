      "evidence_type": "primary",
      "grade": 3,
      "relevance": "primary",
      "m1_page": 58,
      "m1_chunk_id": "3546ee940c3c85f344bbf6c60003f63d8744c3ab68022e4fb726982ca757777e",
      "m1_text_span": "Average is a failing plan! Average doesn't work in any area of life.",
      "m2_chunk_ids": [
        "f6eac46bfbecac0a28bdf7c31190f950bae077c5b762a3f791168205dc2bef84"
      ],
      "status": "exact"
    },
    {

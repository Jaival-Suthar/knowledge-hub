      "evidence_type": "primary",
      "grade": 3,
      "relevance": "primary",
      "m1_page": 135,
      "m1_chunk_id": "33eee9517185def9198ca0ce9ea90b97ab8c936619123cc572363a389645e9c0",
      "m1_text_span": "Persistence is a great advantage to anyone who wants to multiply his or her success",
      "m2_chunk_ids": [
        "4aacd2797da8d5bfd1f816ac8253f52b0c899a58008b85a71f1af39a96dbc728"
      ],
      "status": "exact"
    },

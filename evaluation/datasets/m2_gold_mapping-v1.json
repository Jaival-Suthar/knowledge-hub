      "m1_text_span": "The following is the basic series of mistakes people make when setting out to achieve goals:",
      "m2_chunk_ids": [
        "b9e4daec0cf3b26b214cf994276b7848cf39420947c3eb78b93437ad2ea20f7b"
      ],
      "status": "exact"
